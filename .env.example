# Copy to .env.local (apps/admin) and never commit the real file.
# This list will grow; keep it in sync with what the code actually reads —
# no undocumented mystery variables (see root README / docs/development.md).

# Postgres connection string used by packages/database (Prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/photobooth"

# Owner login: SHA-256 of a 12–180 character password, plus a random secret of at least 32 characters.
# Set these on the admin service. Keep credentials out of source control.
PHOTOBOOTH_ADMIN_PASSWORD_SHA256=""
PHOTOBOOTH_AUTH_SECRET=""
PHOTOBOOTH_ADMIN_ORIGIN="https://photobooth-app-production.up.railway.app"
PHOTOBOOTH_EVENT_SYNC_SECRET=""

# Staff PIN: SHA-256 of a 4-digit PIN, plus a separate random secret of at least 32 characters.
# Set these on the booth service. Do not use the owner password as the staff PIN.
BOOTH_STAFF_PIN_SHA256=""
BOOTH_STAFF_SESSION_SECRET=""
BOOTH_SECURITY_ENFORCED="true"
BOOTH_PUBLIC_URL="https://photobooth-booth-production.up.railway.app"
DELIVERY_DATABASE_URL="${{Postgres.DATABASE_URL}}"
BOOTH_BACKUP_SECRET=""
BOOTH_SESSION_SECRET=""
BOOTH_PAIRING_CODE=""
BOOTH_EMAIL_ENABLED="false"
BOOTH_SMS_ENABLED="false"

# Cloudflare R2 (object storage for photo originals/final/thumbnails).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="friendly-photo-booth"
R2_PUBLIC_BASE_URL=""

# Resend (transactional email for photo sharing links). Not marketing email.
RESEND_API_KEY=""

# Twilio (SMS sharing links). Not marketing SMS.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Public URLs
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000"
NEXT_PUBLIC_GALLERY_BASE_URL="http://localhost:3001"

# Error observability (Sentry or similar) — optional until wired up.
SENTRY_DSN=""
