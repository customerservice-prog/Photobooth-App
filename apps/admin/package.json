{
  "name": "@friendly-photo-booth/admin",
  "private": true,
  "version": "0.1.0",
  "description": "Admin app for Friendly Photo Booth. Real admin shell lands in Phase 1 (see docs/phases.md).",
  "scripts": {
    "prepare:artwork": "cd ../booth && node scripts/prepare-atelier.mjs",
    "predev": "npm run prepare:artwork",
    "dev": "next dev",
    "prebuild": "npm run prepare:artwork",
    "build": "prisma generate && next build",
    "test": "npm run prepare:artwork && node --test tests/*.test.mjs",
    "start": "prisma db push --accept-data-loss --skip-generate && next start -p ${PORT:-3000}"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@prisma/client": "5.20.0",
    "prisma": "5.20.0",
    "qrcode": "1.5.4",
    "sharp": "0.34.4",
    "opentype.js": "1.3.4"
  }
}
